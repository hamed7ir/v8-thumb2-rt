+// 0xBF00'BFc8, c = cond), then the predicated instruction.
+void Assembler::it(Condition cond) {
+  if (cond == al) return;
+  // Keep the constant pool out from between the IT and its instruction.
+  BlockConstPoolFor(2);
+  emit(0xBF00BF08 | (static_cast<uint32_t>(cond) >> 28) << 4);
